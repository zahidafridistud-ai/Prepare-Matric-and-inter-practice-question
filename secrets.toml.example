# Copy this file to .streamlit/secrets.toml (local use only) and add your key.
# NEVER commit secrets.toml to GitHub. On Streamlit Cloud paste these lines into
# Manage app -> Settings -> Secrets instead.
GEMINI_API_KEY = "your_key_here"
GEMINI_MODEL = "gemini-2.5-flash"
MAX_CALLS_PER_SESSION = "60"
